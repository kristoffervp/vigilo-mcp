# Explicit public-file allowlist. Private sessions and local files stay out of Git.
/*
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
!/LICENSE
!/assets/
/assets/*
!/assets/banner.jpg
!/README.md
!/README.no.md
!/CHANGELOG.md
!/CHANGELOG.no.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/src/
/src/*
!/src/attachments.js
!/src/browser.js
!/src/login.js
!/src/login-mobile.js
!/src/mcp-format.js
!/src/mobile-auth.js
!/src/oauth.js
!/src/portal.js
!/src/server.js
!/src/sending.js
!/src/session.js
!/test/
/test/*
!/test/attachments.test.js
!/test/mcp-format.test.js
!/test/mobile-auth.test.js
!/test/oauth.test.js
!/test/portal.test.js
!/test/sending.test.js
!/test/server.test.js
